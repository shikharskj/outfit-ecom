{
  "name": "Ecom",
  "private": true,
  "scripts": {
    "build": "node scripts/check-single-workspace.mjs && turbo run build",
    "dev": "node scripts/check-single-workspace.mjs && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "node scripts/check-single-workspace.mjs && turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
